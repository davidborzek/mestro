import { Theme, Icon, Icons } from "common.slint";

// transient notifications floating above everything: toasts
// (queue adds) top center, the volume OSD bottom center. Rust
// drives visibility with hide timers — the layer only animates.
// Both use the glass tile language of the sheets.
export component OsdLayer inherits Rectangle {
    in property <bool> toast-visible: false;
    in property <string> toast-text;
    in property <bool> osd-visible: false;
    in property <int> osd-level: 50;
    // anchors: 0 top, 1 bottom, 2 left, 3 right, 4 center
    in property <int> toast-anchor: 1;
    in property <int> osd-anchor: 1;
    // [osd] style: solid panel vs the glass default
    in property <bool> solid: false;
    property <color> tile-bg: root.solid ? Theme.panel : Theme.glass;

    background: transparent;

    // the toast: a glass pill with the add icon + track line,
    // anchored per [osd] position; toast-line.preferred-width
    // sizes the pill
    Rectangle {
        x: root.toast-anchor == 2 ? 18px : root.toast-anchor == 3 ? parent.width - self.width - 18px : (parent.width - self.width) / 2;
        y: root.toast-anchor == 0 ? 18px : root.toast-anchor == 1 ? parent.height - 84px : (parent.height - self.height) / 2;
        width: toast-line.preferred-width + 76px;
        height: 44px;
        border-radius: 22px;
        background: root.tile-bg;
        border-width: 1px;
        border-color: Theme.hairline;
        opacity: root.toast-visible ? 1 : 0;
        animate opacity { duration: 200ms; }

        Text {
            text: Icons.glyph(Icon.arrow-insert);
            font-family: Theme.icon-font;
            font-size: 20px;
            color: Theme.accent;
            x: 16px;
            y: (parent.height - self.height) / 2;
        }

        toast-line := Text {
            text: root.toast-text;
            font-size: 14px;
            color: Theme.text;
            x: 48px;
            vertical-alignment: center;
            width: self.preferred-width;
        }
    }

    // the volume OSD: icon + level bar + percent, readable from
    // across the room, anchored per [osd] volume-position
    Rectangle {
        x: root.osd-anchor == 2 ? 18px : root.osd-anchor == 3 ? parent.width - self.width - 18px : (parent.width - self.width) / 2;
        y: root.osd-anchor == 0 ? 18px : root.osd-anchor == 1 ? parent.height - 84px : (parent.height - self.height) / 2;
        width: 300px;
        height: 64px;
        border-radius: 14px;
        background: root.tile-bg;
        border-width: 1px;
        border-color: Theme.hairline;
        opacity: root.osd-visible ? 1 : 0;
        animate opacity { duration: 200ms; }

        Text {
            text: Icons.glyph(root.osd-level == 0 ? Icon.volume-off : root.osd-level < 50 ? Icon.volume-down : Icon.volume-up);
            font-family: Theme.icon-font;
            font-size: 26px;
            color: Theme.accent;
            x: 18px;
            y: (parent.height - self.height) / 2;
        }
        // the track
        Rectangle {
            x: 58px;
            y: (parent.height - 8px) / 2;
            width: 170px;
            height: 8px;
            border-radius: 4px;
            background: Theme.bar;
            // the fill
            Rectangle {
                x: 0;
                width: parent.width * root.osd-level / 100;
                height: 100%;
                border-radius: 4px;
                background: Theme.accent;
                animate width { duration: 100ms; }
            }
        }

        Text {
            text: root.osd-level + "%";
            font-size: 15px;
            color: Theme.text;
            x: 240px;
            vertical-alignment: center;
        }
    }
}
