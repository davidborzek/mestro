import { Theme, Page, RepeatMode, TransportCaps } from "common.slint";
import { ConnectionBanner } from "connection.slint";
import { SearchPage } from "search.slint";
import { SettingsView } from "settings.slint";
import { NowPlayingView } from "nowplaying/nowplaying.slint";
import { QualityItem } from "nowplaying/qualitybadge.slint";
import { VolumePopup } from "nowplaying/volume.slint";
import { NavRail } from "rail.slint";
import { StandbyView } from "standby.slint";
import { OsdLayer } from "osd.slint";
import { QueueEntry, QueuePage } from "queue.slint";
import { LibraryPage } from "library/library.slint";
import { VuPage } from "vu/page.slint";
import { VuPreviewData } from "vu/overview.slint";
import { VuListEntry } from "settings/vu.slint";
import { ClockPreview } from "settings/clock.slint";
import { ConfigErrorView, ConfigProblem } from "config-error.slint";
import { OsdGates } from "settings/widgets.slint";
import { LibEntry } from "library/entry.slint";
import { MenuAction, SheetAction } from "library/sheet.slint";
import { TopBar } from "topbar.slint";
import { HubPage, HubEntryData } from "hub.slint";
import { FirstRunView } from "firstrun.slint";
import { UpdateOverlay } from "update-overlay.slint";
import { HotspotOverlay, HotspotReason } from "hotspot.slint";
import { BootView } from "boot.slint";

export component Mestro inherits Window {
    // preferred (not fixed) size: the desktop backend floats a
    // window at this size; the linuxkms kiosk covers the whole
    // screen regardless — fixed width/height would break
    // SLINT_SCALE_FACTOR (the scene would overflow instead of
    // reflowing). Driven by --size=WxH, --kiosk and --fullscreen.
    in property <length> start-w: 800px;
    in property <length> start-h: 480px;
    in property <bool> fullscreen;
    preferred-width: start-w;
    preferred-height: start-h;
    full-screen: fullscreen;
    title: @tr("Mestro");
    background: Theme.bg;
    in-out property <Page> page: Page.hub;
    // navigation goes through Rust: it owns the back stack
    // (slint arrays are read-only in the language)
    callback nav-go(Page);
    callback nav-back();
    callback restart-app();
    // the abstract control channel (mestro_ipc::command): the
    // keyboard speaks it today, a WebSocket/IR/USB-remote
    // transport can push the same vocabulary from Rust tomorrow.
    // Raw keys land here as KeyEvent.text; Rust owns the
    // configurable key -> command map ([keyboard])
    callback control-command(cmd: string);
    callback key-event(text: string);
    // the embedded web endpoint (src/web/): JSON envelope in,
    // JSON envelope out — the bridge calls this on the UI thread
    callback web-op(request: string) -> string;
    // the OSD layer: toasts (queue adds) and the volume OSD —
    // Rust shows and auto-hides both; anchors come from [osd]
    in property <bool> toast-visible: false;
    in property <string> toast-text;
    in property <bool> osd-visible: false;
    in property <int> osd-level: 50;
    in property <int> toast-anchor: 1;
    in property <int> osd-anchor: 1;
    in property <bool> osd-solid: false;
    callback show-toast(text: string);
    callback show-osd-volume(level: int);
    // theme.palette = "cover": Rust hands over the artwork's
    // dominant color; globals need imperative assignment (the
    // codegen folds constant-only globals away, and exports no
    // accessor — the callback bridges that)
    callback set-accent(c: color, d: color);
    set-accent(c, d) => {
        Theme.accent = c;
        Theme.danger = d;
    }
    // the live accent for runtime skins (they cannot import Theme)
    out property <color> accent-color: Theme.accent;
    callback nav-home();
    // now-playing is a persistent overlay, not a page: the content
    // below (list scroll position!) survives the peek roundtrip
    in-out property <bool> np-open: false;
    // the queue sits in the same overlay layer as now-playing
    // (always mounted; the layer stack decides which is visible)
    in-out property <bool> queue-open: false;
    in-out property <bool> vu-open: false;
    callback vu-sync();
    callback vu-present(int);
    callback vu-clear();
    out property <bool> vu-transitioning: vu-page.transitioning;
    vu-present(direction) => {
        vu-page.present(direction);
    }
    vu-clear => {
        vu-page.clear-skins();
    }
    // ghost-arrow hint on the VU faceplate (auto-hide, 2s)
    in property <bool> vu-hint: false;
    callback vu-activity();
    // swiping the faceplate horizontally cycles the views
    callback vu-cycle();
    callback vu-cycle-back();
    // the preset info lines (night/cream/round): one segment row
    // per configured template
    in property <[string]> vu-info-lines;
    in property <int> vu-info-count: 0;
    // [vu.wall-light] glow: the orange backlight intensity
    // the active skin's plate lightness flips the ghost-arrow ink
    in property <bool> vu-arrow-dark: false;
    // the VU cycle: view count + active index (dots + rails)
    in property <int> vu-view-count: 0;
    in property <int> vu-view-index: 0;
    // the cycle's skin names, in view-index order
    in property <[string]> vu-view-names: [];
    // fires on every view-relevant change (np/queue/vu/standby,
    // the VU cycle and its skins, the backlight, the provider
    // connection) — Rust publishes the new view snapshot to the
    // phones' push pipeline at once, no poll
    callback view-changed();
    changed np-open => {
        root.view-changed();
    }
    changed queue-open => {
        root.view-changed();
    }
    changed vu-open => {
        root.view-changed();
    }
    changed vu-view-index => {
        root.view-changed();
    }
    changed vu-view-count => {
        root.view-changed();
    }
    changed vu-view-names => {
        root.view-changed();
    }
    changed display-brightness => {
        root.view-changed();
    }
    changed display-supported => {
        root.view-changed();
    }
    changed provider-connected => {
        root.view-changed();
    }
    in property <[VuPreviewData]> vu-previews: [];
    in-out property <bool> vu-overview-open: false;
    callback vu-open-overview();
    callback vu-select-preview(int);
    // VU settings (settings view 8/9)
    in property <[VuListEntry]> vu-list: [];
    in property <string> vu-edit-name: "";
    in property <image> vu-edit-preview;
    in property <float> vu-glow-value: 0;
    in property <bool> vu-glow-overridden: false;
    in property <[string]> vu-info-order: [];
    in property <[string]> vu-info-inactive: [];
    in property <bool> vu-info-overridden: false;
    in property <bool> vu-meters-value: false;
    in property <bool> vu-meters-overridden: false;
    in property <bool> vu-gradient-value: false;
    in property <bool> vu-gradient-overridden: false;
    callback vu-move(string, int);
    callback vu-toggle-cycle(string);
    callback vu-open-options(string);
    callback vu-toggle-info(string);
    callback vu-move-info(string, int);
    // [vu.cream] / [vu.round] glow: warm backlight wash
    in-out property <component-factory> vu-skin-factory;
    callback open-np();
    callback close-np();
    callback np-open-queue();
    callback np-open-vu();
    // the glass capsule rides the hub (without back — the tiles
    // are the navigation) and the content subpages; the queue
    // carries its own header
    private property <bool> capsule-page:
        root.page == Page.hub || root.page == Page.library || root.page == Page.lyrics || root.page == Page.search || root.page == Page.settings;

    in property <image> cover;
    in property <image> bg-cover;
    // the cover's dominant color — the UI accent follows it
    // ([vu] cover-palette; amber fallback handled in Rust)
    in property <color> ui-accent: #d8a657;
    in property <float> vu-l: 0;
    // [now-playing]: per-line metadata font sizes (px) and
    // weights, inline VU toggle, quality display
    // (0 off / 1 codec / 2 detail / 3 both)
    in property <float> np-title-size: 24;
    in property <int> np-title-weight: 700;
    in property <float> np-artist-size: 18;
    in property <int> np-artist-weight: 400;
    in property <float> np-album-size: 14;
    in property <int> np-album-weight: 400;
    in property <float> np-quality-size: 12;
    in property <int> np-quality-weight: 400;
    // [now-playing] inline VU: 0 off, 1 LED strips, 2 thin bars
    in property <int> np-inline-vu: 1;
    // the spectrum bands for the matrix inline VU ([float], 0..1)
    in property <[float]> np-bands: [];
    // [now-playing] layout: 0 side (square cover), 1 fullbleed
    // (sharp cover edge to edge)
    in property <int> np-layout: 0;
    // [now-playing] controls: which transport buttons the row
    // shows, in display order
    in property <[string]> np-controls: ["shuffle", "previous", "play-pause", "next", "repeat"];
    // queue-level playback options: shuffle + repeat (0 off,
    // 1 all, 2 one) — confirmed by the queue event
    in property <bool> np-shuffle: false;
    in property <RepeatMode> np-repeat: RepeatMode.off;
    // [now-playing] quality: codec badge on/off; the detail line
    // arrives pre-assembled in the quality property
    in property <[QualityItem]> np-quality-items: [];
    in property <float> vu-r: 0;
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <string> quality;
    in property <string> codec;
    in property <bool> lossless;
    in property <bool> powered;
    in property <bool> has-media;
    // the shown track has no artwork of its own (external sources)
    in property <bool> cover-missing: false;
    // the external source playing on the player (AirPlay, ...),
    // empty = the MA queue: queue-bound controls and the queue
    // view are off while it is set
    in property <string> external-source;
    in property <TransportCaps> transport-caps: { play-pause: true, next-previous: true, shuffle: true, repeat: true };
    private property <bool> backdrop-visible: root.backdrop-enabled && root.has-media && !root.cover-missing;
    in property <bool> backdrop-enabled;
    in property <bool> clock-analog;
    in property <string> clock-label;
    // false while the system time is not trustworthy yet (no RTC, NTP
    // not answered): the faces show "--:--" instead of a wrong time
    in property <bool> clock-valid: true;
    // standby date line (digital face), e.g. "MON 09 NOV"
    in property <string> clock-date;
    // custom standby skin ([clock.skins]): Rust sets the factory
    in-out property <component-factory> standby-skin-factory;
    in property <bool> standby-skin-active: false;
    // standby backdrop ([clock.background], src/standby.rs)
    in property <image> standby-bg-a;
    in property <image> standby-bg-b;
    in property <bool> standby-bg-front-b: false;
    in property <bool> standby-bg-shown: false;
    in property <float> standby-bg-dim: 0.6;
    // a decoded folder image arrives from the loader thread
    callback standby-bg-present(image);
    // a skin's power-on() lands here — same path as the tap.
    // Standby only covers the page stack, so waking reveals
    // whatever was open before
    callback standby-power-on();
    standby-power-on => {
        root.set-power(true);
    }
    // provider failure banner (empty = healthy): auth rejected,
    // server unreachable. Sits above every layer incl. standby —
    // a kiosk with a dead data source must not look healthy
    in property <string> provider-status;
    // the boot screen while network and server come up: 0 gone,
    // 1 waiting for the network, 2 connecting (the session drives it)
    in property <int> startup-phase: 0;
    // the server's host, for the connecting line
    in property <string> startup-server;
    // for the settings about page
    in property <string> app-version: "dev";
    // system update in progress (empty = none): the full-screen
    // overlay with this text, set from the web thread
    in-out property <string> update-status: "";
    out property <bool> update-overlay-visible: update-overlay.visible;
    // settings edits: dotted key + number value — routed through
    // the control channel (Command::SetSetting), the same
    // vocabulary a future web/IPC client speaks
    callback set-setting-num(string, float);
    callback set-setting-text(string, string);
    callback set-setting-bool(string, bool);
    callback reset-setting-value(string);
    // theme + ui effective values (config names)
    in property <string> theme-palette: "amber";
    in property <string> theme-variant: "tonal-spot";
    in property <string> ui-rail: "dark";
    in property <bool> ui-auto-open: true;
    in property <string> ui-osk: "de";
    in property <bool> theme-palette-overridden: false;
    in property <bool> theme-variant-overridden: false;
    in property <bool> ui-rail-overridden: false;
    in property <bool> ui-auto-open-overridden: false;
    in property <bool> ui-osk-overridden: false;
    in property <bool> bg-blurred: true;
    in property <bool> bg-blurred-overridden: false;
    // clock
    in property <string> clock-style: "digital";
    in property <[ClockPreview]> clock-previews: [];
    in property <string> bg-source: "black";
    in property <bool> bg-source-overridden: false;
    in property <float> bg-dim: 60;
    in property <bool> bg-dim-overridden: false;
    in property <bool> bg-blur: false;
    in property <bool> bg-blur-overridden: false;
    in property <float> bg-interval: 10;
    in property <bool> bg-interval-overridden: false;
    in property <bool> clock-style-overridden: false;
    // hub (home screen): layout + entry order
    in property <string> hub-look: "cards";
    in property <bool> hub-look-overridden: false;
    in property <[string]> hub-order: [];
    in property <bool> hub-order-overridden: false;
    // osd: the notification layer
    in property <string> osd-style: "translucent";
    in property <bool> osd-style-overridden: false;
    in property <string> osd-position: "bottom";
    in property <bool> osd-position-overridden: false;
    in property <string> osd-volume-position: "bottom";
    in property <bool> osd-volume-position-overridden: false;
    in property <float> osd-toast-duration: 2600;
    // display (backlight — only rendered when supported)
    in property <float> display-brightness: 100;
    in property <bool> display-brightness-overridden: false;
    in property <bool> display-supported: false;
    in property <float> display-standby-brightness: 15;
    in property <bool> display-standby-brightness-overridden: false;
    // the standby clock covers the UI: same condition as its `if`
    // below — Rust dims the backlight on the edge. The hotspot
    // overlay mounts ABOVE it and keeps the panel readable: while
    // its QR shows, the player is not visually in standby — the
    // backlight never dims to the standby brightness under it
    out property <bool> standby-showing:
        !root.powered && root.provider-status == "" && !root.hotspot-active;
    callback standby-changed(bool);
    changed standby-showing => {
        root.standby-changed(root.standby-showing);
        root.view-changed();
    }
    in property <bool> osd-toast-duration-overridden: false;
    in property <float> osd-volume-duration: 1800;
    in property <bool> osd-volume-duration-overridden: false;
    in property <OsdGates> osd-gates;
    in property <OsdGates> osd-np-gates;
    in property <OsdGates> osd-vu-gates;
    callback move-hub(string, int);
    // connection (music-assistant family — restart-class):
    // status/recovery display, editing lives in the remote wizard
    in property <string> conn-url: "";
    in property <string> conn-player: "";
    in property <bool> conn-token-set: false;
    // overlay state: the reset buttons show only on overridden
    // keys — Rust re-pushes these flags on every set/reset
    in property <bool> np-title-size-overridden: false;
    in property <bool> np-artist-size-overridden: false;
    in property <bool> np-album-size-overridden: false;
    in property <bool> np-quality-size-overridden: false;
    in property <bool> np-title-weight-overridden: false;
    in property <bool> np-artist-weight-overridden: false;
    in property <bool> np-album-weight-overridden: false;
    in property <bool> np-quality-weight-overridden: false;
    in property <bool> np-inline-vu-overridden: false;
    in property <bool> np-layout-overridden: false;
    in property <bool> np-controls-overridden: false;
    in property <bool> np-quality-overridden: false;
    // chip membership (canonical order, Rust pushes after every
    // change)
    callback toggle-control(string);
    callback toggle-quality-part(string);
    callback move-control(string, int);
    callback move-quality-part(string, int);
    // order models — Rust rebuilds them after every change
    in property <[string]> ctrl-order: [];
    in property <[string]> ctrl-inactive: [];
    in property <[string]> quality-order: [];
    in property <[string]> quality-inactive: [];
    // the settings layer: config.toml base, edits on top of it
    in property <string> settings-base-config: "";
    in property <bool> settings-overrides-active: false;
    // the remote setup wizard URL (incl. pairing PIN)
    in property <string> settings-remote-url: "";
    // what the config loader ignored (empty = clean config)
    in property <[ConfigProblem]> config-problems: [];
    // "set up again" from the config-error screen: the wizard is
    // wanted on purpose now, the errors no longer block it
    in-out property <bool> setup-anyway: false;
    // first-run setup overlay: wizard QR until connected
    in property <bool> first-run: false;
    in property <bool> first-run-detected: false;
    in property <image> first-run-qr;
    // the wifi setup hotspot (feature wifi-setup): the overlay
    // above every layer but the update — first run and the
    // lost-network fallback alike. Inert unless the wifi manager
    // raised AP mode; Rust clears it when AP mode ends
    in property <bool> hotspot-active: false;
    in property <HotspotReason> hotspot-reason: HotspotReason.setup;
    in property <string> hotspot-ssid: "";
    // the setup address the overlay names (mestro.setup — the
    // port spelled out when it is not the URL default 80)
    in property <string> hotspot-portal: "mestro.setup";
    in property <image> hotspot-qr;
    in property <string> hotspot-saved-ssid: "";
    // verified connection (real events flowed) — the overlay's
    // dismissal truth, provider-owned
    in property <bool> provider-connected: false;
    // a clear re-arms the overlay (it is dismissed, not gone)
    changed first-run-detected => {
        if (!root.first-run-detected) {
            root.first-run-dismissed = false;
        }
    }
    callback reset-all-settings;
    // clear the whole music-assistant connection
    callback reset-connection();
    // the settings page's internal view (0 index) — the rail
    // back button pops details to it first
    in-out property <int> subview: 0;
    // the settings scroll offset (bound to the settings page) and a
    // count of subview pushes: a push opens fresh, a back restores
    in-out property <length> settings-scroll-y;
    in property <int> subview-pushes: 0;

    callback push-subview(int);
    // the page modal slot: pages report open modals here; the
    // router pulses sheet-close-token to dismiss them (back)
    in-out property <bool> sheet-open;
    in-out property <int> sheet-close-token: 0;
    in property <int> clock-minute;
    in property <int> clock-hour;
    // hub greeting + its sub line (date · player)
    in property <string> hub-greeting;
    in property <string> hub-sub;
    // [hub] layout: 0 cards, 1 list
    in property <int> hub-layout: 0;
    // compact hub rows (short windows — set from the CLI size)
    in property <bool> hub-compact: false;
    // 0 = dark bezel rail, 1 = translucent glass rail
    in property <int> rail-style: 0;
    // [ui] osk-layout: the OskLayouts registry key (see
    // ui/osk.slint — resolve() maps it to rows)
    in property <string> osk-layout: "de";
    // single source for the rail width: the layout column AND
    // the one view that intentionally runs under it (np fullbleed
    // — bezel glow) reference it
    property <length> rail-width: 56px;
    // the hub destinations, ordered per [hub] order
    in property <[HubEntryData]> hub-entries: [];
    callback hub-entry(int);
    // kind dispatch: 0 library, 1 search, 2 settings, 3 standby
    hub-entry(kind) => {
        if kind == 0 {
            root.nav-go(Page.library);
        } else if kind == 1 {
            root.nav-go(Page.search);
        } else if kind == 2 {
            root.nav-go(Page.settings);
        } else if kind == 3 {
            root.set-power(false);
        }
    }
    in property <float> progress;
    in property <string> pos-label;
    in property <int> duration-seconds;
    in property <bool> can-seek: false;
    in property <string> seek-track-key;
    callback seek(float, string);
    in property <string> dur-label;
    in property <bool> playing;
    in property <bool> loading;

    in property <float> loading-opacity;
    in-out property <int> volume;
    // drives the volume HUD drop-in animation (two-way: the
    // popup's properties are not assignable from the window)
    in-out property <bool> vol-hud-in: false;
    in property <[QueueEntry]> queue-model;

    // library browse state: the current list, its level title and
    // the fetch-in-flight flag (first provider fetches are slow).
    // Detail levels (artist/album/playlist) render a subject header
    // instead of the breadcrumb
    in property <[LibEntry]> lib-model;
    in property <string> lib-title;
    in property <bool> lib-loading;
    in property <string> lib-mode: "list";
    in property <LibEntry> lib-subject;
    in property <string> lib-meta;
    in property <image> lib-cover;
    in-out property <length> lib-scroll;

    // search state: the query is Rust-owned (the OSK drives it,
    // the field mirrors it); results reuse the library row struct.
    // The keyboard dock state lives here — it survives page trips
    in-out property <string> search-query;
    // char count of the query — the field caret rides along
    // (cursor positions are char offsets)
    in property <int> search-query-len;
    // debug: the field focus state (OSK double-press hunt)
    in property <bool> search-loading;
    in property <[LibEntry]> search-model;
    in-out property <bool> search-osk-visible: true;
    /// the OSK dispatches synthetic key events into the focused
    /// field (letters/space as-is, "backspace"/"return" for the
    /// specials) — the slint virtual-keyboard pattern
    callback osk-key(string);
    callback search-edited(string);
    callback search-fire();
    callback search-open(LibEntry);
    callback search-clear();

    callback open-lib-entry(LibEntry);
    callback play-lib-subject();
    // context menu: compose the action list for a held entry /
    // dispatch the tapped action id
    callback lib-menu(LibEntry) -> [SheetAction];
    callback lib-menu-trigger(MenuAction, LibEntry);
    callback lib-back();
    in-out property <bool> lib-menu-open: false;

    callback toggle-play();
    callback next-track();
    callback prev-track();
    // queue-level playback options (transport + queue header)
    callback shuffle-toggle();
    callback repeat-cycle();
    callback volume-set(int);
    callback play-queue-item(string);
    callback remove-queue-item(string);
    // queue row context menu: compose + dispatch
    callback queue-menu(QueueEntry) -> [SheetAction];
    callback queue-menu-trigger(MenuAction, QueueEntry);
    // the now-playing metadata go-to sheet
    callback np-meta-menu() -> [SheetAction];
    callback np-meta-trigger(MenuAction);
    callback clear-queue();
    callback set-power(bool);

    public function open-volume-popup() {
        // replay the drop-in per show: reset, show, flip one tick
        // later (a PopupWindow has no "shown" hook, and its
        // properties are not assignable from the enclosing
        // window — the flag two-way binds into the popup)
        root.vol-hud-in = false;
        vol-popup.show();
        vol-anim.running = true;
    }

    // blurred, dimmed cover backdrop — disabled by config. Root
    // level, FULLSCREEN: it runs under the nav rail too, so the
    // translucent glass rail option has art to show; pages sit
    // above it inside the app zone
    Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: root.bg-cover;
        image-fit: ImageFit.cover;
        visible: root.backdrop-visible;
    }

    // the dim over the backdrop: the settings get a much darker
    // one — their translucent tiles picked up the cover's colors
    // and the rows went restless with every track
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: root.page == Page.settings ? #14120feb : #14120fc0;
        visible: root.backdrop-visible;
    }

    // root layout: the app content zone takes everything left
    // of the nav rail — the rail is a layout column, not an
    // overlay, so no view needs manual offsets; layouts skip
    // invisible children, so the zone goes fullscreen when the
    // rail hides (standby)
    HorizontalLayout {
        app-zone := Rectangle {
            horizontal-stretch: 1;

            // content: pages stacked as full-size overlays of each other,
    // never unmounted (scroll position survives switches, no
    // re-instantiation cost). Layouts would still allocate space
    // for invisible siblings — hence absolute geometry, no slots
    Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;

                // content subpages sit below the floating glass capsule
        VerticalLayout {
                    visible: root.capsule-page;
                    width: parent.width;
                    height: parent.height;
                    padding-top: 56px;
                    padding-left: 0px;
                    padding-right: 0px;
                    padding-bottom: 0px;
                    spacing: 0px;

                    // content area below the capsule inset
            Rectangle {
                        HubPage {
                            visible: root.page == Page.hub;
                            width: parent.width;
                            height: parent.height;
                            greet-title: root.hub-greeting;
                            greet-sub: root.hub-sub;
                            hub-layout: root.hub-layout;
                            compact: root.hub-compact;
                            entries: root.hub-entries;
                            entry-activated(kind) => {
                                root.hub-entry(kind);
                            }
                        }

                        LibraryPage {
                            visible: root.page == Page.library;
                            width: parent.width;
                            height: parent.height;
                            entries: root.lib-model;
                            title: root.lib-title;
                            loading: root.lib-loading;
                            mode: root.lib-mode;
                            subject: root.lib-subject;
                            meta: root.lib-meta;
                            subject-cover: root.lib-cover;
                            scroll-y <=> root.lib-scroll;
                            open(entry) => {
                                root.open-lib-entry(entry);
                            }
                            play-subject => {
                                root.play-lib-subject();
                            }
                            menu(entry) => {
                                root.lib-menu(entry);
                            }
                            menu-trigger(id, entry) => {
                                root.lib-menu-trigger(id, entry);
                            }
                            back => {
                                root.lib-back();
                            }
                            menu-open <=> root.lib-menu-open;
                        }

                        if root.page == Page.lyrics: Rectangle {
                            width: parent.width;
                            height: parent.height;

                            Text {
                                text: @tr("lyrics — coming later");
                                color: Theme.text-mute;
                            }
                        }

                        if root.page == Page.search: SearchPage {
                            width: parent.width;
                            height: parent.height;
                            layout: root.osk-layout;
                            query <=> root.search-query;
                            query-length: root.search-query-len;
                            loading: root.search-loading;
                            results: root.search-model;
                            osk-visible <=> root.search-osk-visible;
                            edited(t) => {
                                root.search-edited(t);
                            }
                            submitted => {
                                root.search-fire();
                            }
                            osk-key(k) => {
                                root.osk-key(k);
                            }
                            open(e) => {
                                root.search-open(e);
                            }
                            clear => {
                                root.search-clear();
                            }
                            menu-request(e) => {
                                root.lib-menu(e);
                            }
                            menu-trigger(id, entry) => {
                                root.lib-menu-trigger(id, entry);
                            }
                        }

                        if root.page == Page.settings: SettingsView {
                            width: parent.width;
                            height: parent.height;
                            view <=> root.subview;
                            config-problems: root.config-problems;
                            scroll-y <=> root.settings-scroll-y;
                            push-count: root.subview-pushes;
                            push-subview(s) => {
                                root.push-subview(s);
                            }
                            sheet-open <=> root.sheet-open;
                            close-token: root.sheet-close-token;
                            np-title-size: root.np-title-size;
                            np-artist-size: root.np-artist-size;
                            np-album-size: root.np-album-size;
                            np-quality-size: root.np-quality-size;
                            np-title-weight: root.np-title-weight;
                            np-artist-weight: root.np-artist-weight;
                            np-album-weight: root.np-album-weight;
                            np-quality-weight: root.np-quality-weight;
                            np-inline-vu: root.np-inline-vu;
                            np-layout: root.np-layout;
                            app-version: root.app-version;
                            set-num(k, v) => {
                                root.set-setting-num(k, v);
                            }
                            set-text(k, v) => {
                                root.set-setting-text(k, v);
                            }
                            set-bool(k, v) => {
                                root.set-setting-bool(k, v);
                            }
                            theme-palette: root.theme-palette;
                            theme-variant: root.theme-variant;
                            ui-rail: root.ui-rail;
                            ui-auto-open: root.ui-auto-open;
                            ui-osk: root.ui-osk;
                            bg-blurred: root.bg-blurred;
                            bg-blurred-overridden: root.bg-blurred-overridden;
                            clock-style: root.clock-style;
                            clock-previews: root.clock-previews;
                            bg-source: root.bg-source;
                            bg-source-overridden: root.bg-source-overridden;
                            bg-dim: root.bg-dim;
                            bg-dim-overridden: root.bg-dim-overridden;
                            bg-blur: root.bg-blur;
                            bg-blur-overridden: root.bg-blur-overridden;
                            bg-interval: root.bg-interval;
                            bg-interval-overridden: root.bg-interval-overridden;
                            clock-style-overridden: root.clock-style-overridden;
                            hub-look: root.hub-look;
                            hub-look-overridden: root.hub-look-overridden;
                            hub-order: root.hub-order;
                            hub-order-overridden: root.hub-order-overridden;
                            osd-style: root.osd-style;
                            osd-style-overridden: root.osd-style-overridden;
                            osd-position: root.osd-position;
                            osd-position-overridden: root.osd-position-overridden;
                            osd-volume-position: root.osd-volume-position;
                            osd-volume-position-overridden: root.osd-volume-position-overridden;
                            osd-toast-duration: root.osd-toast-duration;
                            osd-toast-duration-overridden: root.osd-toast-duration-overridden;
                            osd-volume-duration: root.osd-volume-duration;
                            osd-volume-duration-overridden: root.osd-volume-duration-overridden;
                            display-brightness: root.display-brightness;
                            display-brightness-overridden: root.display-brightness-overridden;
                            display-supported: root.display-supported;
                            display-standby-brightness: root.display-standby-brightness;
                            display-standby-brightness-overridden: root.display-standby-brightness-overridden;
                            osd-gates: root.osd-gates;
                            osd-np-gates: root.osd-np-gates;
                            osd-vu-gates: root.osd-vu-gates;
                            move-hub(n, d) => {
                                root.move-hub(n, d);
                            }
                            conn-url: root.conn-url;
                            conn-player: root.conn-player;
                            conn-token-set: root.conn-token-set;
                            provider-status: root.provider-status;
                            remote-url: root.settings-remote-url;
                            remote-qr: root.first-run-qr;
                            reset-connection => {
                                root.reset-connection();
                            }
                            theme-palette-overridden: root.theme-palette-overridden;
                            theme-variant-overridden: root.theme-variant-overridden;
                            ui-rail-overridden: root.ui-rail-overridden;
                            ui-auto-open-overridden: root.ui-auto-open-overridden;
                            ui-osk-overridden: root.ui-osk-overridden;
                            reset-value(k) => {
                                root.reset-setting-value(k);
                            }
                            restart-app => {
                                root.restart-app();
                            }
                            np-title-size-overridden: root.np-title-size-overridden;
                            np-artist-size-overridden: root.np-artist-size-overridden;
                            np-album-size-overridden: root.np-album-size-overridden;
                            np-quality-size-overridden: root.np-quality-size-overridden;
                            np-title-weight-overridden: root.np-title-weight-overridden;
                            np-artist-weight-overridden: root.np-artist-weight-overridden;
                            np-album-weight-overridden: root.np-album-weight-overridden;
                            np-quality-weight-overridden: root.np-quality-weight-overridden;
                            np-inline-vu-overridden: root.np-inline-vu-overridden;
                            np-layout-overridden: root.np-layout-overridden;
                            np-controls-overridden: root.np-controls-overridden;
                            np-quality-overridden: root.np-quality-overridden;
                            toggle-control(n) => {
                                root.toggle-control(n);
                            }
                            toggle-quality-part(n) => {
                                root.toggle-quality-part(n);
                            }
                            move-control(n, d) => {
                                root.move-control(n, d);
                            }
                            move-quality-part(n, d) => {
                                root.move-quality-part(n, d);
                            }
                            ctrl-order: root.ctrl-order;
                            ctrl-inactive: root.ctrl-inactive;
                            quality-order: root.quality-order;
                            quality-inactive: root.quality-inactive;
                            base-config: root.settings-base-config;
                            overrides-active: root.settings-overrides-active;
                            reset-all => {
                                root.reset-all-settings();
                            }
                            vu-list: root.vu-list;
                            vu-edit-name: root.vu-edit-name;
                            vu-edit-preview: root.vu-edit-preview;
                            vu-glow-value: root.vu-glow-value;
                            vu-glow-overridden: root.vu-glow-overridden;
                            vu-info-order: root.vu-info-order;
                            vu-info-inactive: root.vu-info-inactive;
                            vu-info-overridden: root.vu-info-overridden;
                            vu-meters-value: root.vu-meters-value;
                            vu-meters-overridden: root.vu-meters-overridden;
                            vu-gradient-value: root.vu-gradient-value;
                            vu-gradient-overridden: root.vu-gradient-overridden;
                            vu-move(n, d) => {
                                root.vu-move(n, d);
                            }
                            vu-toggle-cycle(n) => {
                                root.vu-toggle-cycle(n);
                            }
                            vu-open-options(n) => {
                                root.vu-open-options(n);
                            }
                            vu-toggle-info(n) => {
                                root.vu-toggle-info(n);
                            }
                            vu-move-info(n, d) => {
                                root.vu-move-info(n, d);
                            }
                        }
                    }
                }
            }

            // the global glass capsule — only on the content subpages;
    // hub and queue carry their own headers
    if root.capsule-page: TopBar {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                cover: root.cover;
                np-label: root.has-media ? root.track-title + " — " + root.track-artist : @tr("Nothing playing");
                has-media: root.has-media;
                clock-label: root.clock-label;
                open-np => {
                    root.open-np();
                }
            }

            // now-playing as a persistent overlay: it covers the content
    // pages without unmounting them — a deep list scroll survives
    // the peek roundtrip, closing is instant. The overlay itself
    // stays mounted too (visible toggle) so the NP side of the
    // roundtrip costs nothing. Own backdrop copy: the pages below
    // are transparent. Zone-sized like every other view — the
    // under-rail bezel glow needs the art to continue under the
    // rail, which the layout column architecture doesn't give
    // us; revisit with a dedicated rail backdrop later
    Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                visible: root.np-open;
        // opaque base: with no backdrop (idle, or backdrop
        // disabled) the page below would shine through — and
        // an unpainted rectangle grabs no input, so the hub
        // would even stay clickable through the overlay
        background: Theme.bg;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.bg-cover;
                    image-fit: ImageFit.cover;
                    visible: root.backdrop-visible;
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #14120fc0;
                    visible: root.backdrop-visible;
                }

                NowPlayingView {
                    meta-menu() => {
                        root.np-meta-menu();
                    }
                    meta-trigger(id) => {
                        root.np-meta-trigger(id);
                    }
                    volume: root.volume;
                    width: 100%;
                    height: 100%;
                    cover: root.cover;
                    title: root.track-title;
                    artist: root.track-artist;
                    album: root.track-album;
                    lossless: root.lossless;
                    vu-l: root.vu-l;
                    vu-r: root.vu-r;
                    np-title-size: root.np-title-size;
                    np-title-weight: root.np-title-weight;
                    np-artist-size: root.np-artist-size;
                    np-artist-weight: root.np-artist-weight;
                    np-album-size: root.np-album-size;
                    np-album-weight: root.np-album-weight;
                    np-quality-size: root.np-quality-size;
                    np-quality-weight: root.np-quality-weight;
                    inline-vu: root.np-inline-vu;
                    np-layout: root.np-layout;
                    controls: root.np-controls;
                    np-bands: root.np-bands;
                    np-quality-items: root.np-quality-items;
                    has-media: root.has-media;
                    cover-missing: root.cover-missing;
                    external-source: root.external-source;
                    transport-caps: root.transport-caps;
                    playing: root.playing;
                    loading: root.loading;
                    loading-opacity: root.loading-opacity;
                    shuffle: root.np-shuffle;
                    repeat: root.np-repeat;
                    progress: root.progress;
                    duration-seconds: root.duration-seconds;
                    can-seek: root.can-seek;
                    seek-track-key: root.seek-track-key;
                    seek(fraction, key) => {
                        root.seek(fraction, key);
                    }
                    pos-label: root.pos-label;
                    dur-label: root.dur-label;
            // the chevron closes the overlay — the page below is
            // exactly where the peek started from
            open-queue => {
                        root.np-open-queue();
                    }
                    open-vu => {
                        root.np-open-vu();
                    }
                    open-volume => {
                        root.open-volume-popup();
                    }

                    toggle-play => {
                        root.toggle-play();
                    }
                    next-track => {
                        root.next-track();
                    }
                    prev-track => {
                        root.prev-track();
                    }
                    shuffle-toggle => {
                        root.shuffle-toggle();
                    }
                    repeat-cycle => {
                        root.repeat-cycle();
                    }
                }
            }

            // the queue overlay: same layer treatment as now-playing —
    // persistent, opaque backdrop of its own, only visibility
    // toggles
    Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                visible: root.queue-open;
                background: Theme.bg;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.bg-cover;
                    image-fit: ImageFit.cover;
                    visible: root.backdrop-visible;
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #14120fc0;
                    visible: root.backdrop-visible;
                }

                QueuePage {
                    width: 100%;
                    height: 100%;
                    entries: root.queue-model;
                    shuffle: root.np-shuffle;
                    repeat: root.np-repeat;
                    play-item(id) => {
                        root.play-queue-item(id);
                    }
                    remove-item(id) => {
                        root.remove-queue-item(id);
                    }
                    clear-queue => {
                        root.clear-queue();
                    }
                    shuffle-toggle => {
                        root.shuffle-toggle();
                    }
                    repeat-cycle => {
                        root.repeat-cycle();
                    }
                    menu(e) => {
                        root.queue-menu(e);
                    }
                    menu-trigger(id, e) => {
                        root.queue-menu-trigger(id, e);
                    }
                }
            }

            // the VU faceplate overlay: same layer treatment as the
    // queue — persistent mount, own backdrop copy, its own minimal
    // top bar with just the back arrow
    vu-layer := Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                visible: root.vu-open;

                vu-page := VuPage {
                    width: 100%;
                    height: 100%;
                    arrow-dark: root.vu-arrow-dark;
                    level-l: root.vu-l;
                    level-r: root.vu-r;
                    title: root.track-title;
                    artist: root.track-artist;
                    codec: root.codec;
                    quality: root.quality;
                    lossless: root.lossless;
                    info-lines: root.vu-info-lines;
                    info-count: root.vu-info-count;
                    hint: root.vu-hint;
                    view-count: root.vu-view-count;
                    view-index: root.vu-view-index;
                    previews: root.vu-previews;
                    overview-open <=> root.vu-overview-open;
                    open-overview => {
                        root.vu-open-overview();
                    }
                    select-preview(index) => {
                        root.vu-select-preview(index);
                    }
                    activity => {
                        root.vu-activity();
                    }
                    cycle => {
                        root.vu-cycle();
                    }
                    cycle-back => {
                        root.vu-cycle-back();
                    }
                    skin-factory: root.vu-skin-factory;
                    back => {
                        if root.vu-overview-open {
                            root.vu-overview-open = false;
                        } else {
                            root.nav-back();
                        }
                    }
                }
            }

            // volume popup floats above every zone layer — the HUD pill
    // sits top center, clear of the rail and the cover
    vol-anim := Timer {
                interval: 1ms;
                running: false;
                triggered => {
                    root.vol-hud-in = true;
                    self.running = false;
                }
            }

            vol_popup := VolumePopup {
                x: (parent.width - self.width) / 2;
                y: 18px;
                anim-in <=> root.vol-hud-in;
                volume <=> root.volume;
                volume-set(v) => {
                    root.volume-set(v);
                }
            }
        }

        // the rail's layout slot: a transparent spacer keeps the
    // zone inset while the rail itself paints at root level —
    // above the zone content, over the np fullbleed art underhang.
    // Layouts skip invisible children: gone on standby the zone
    // takes the full width again
    if root.powered || root.provider-status != "": Rectangle {
            width: root.rail-width;
        }
    }

    // the global nav rail: root overlay on the right bezel,
    // transport + back/home everywhere. Sits above the zone
    // layers; the glass variant shows the blurred-cover backdrop
    // through (root-level, fullscreen) with a bottom gradient
    NavRail {
        x: root.width - root.rail-width;
        y: 0;
        width: root.rail-width;
        height: 100%;
        visible: root.powered || root.provider-status != "";
        playing: root.playing;
        // nav buttons only away from the pure hub — with an
        // overlay (np/queue/vu) back must stay reachable
        show-nav: root.provider-status != "" || root.page != Page.hub || root.np-open || root.queue-open || root.vu-open;
        style: root.rail-style;
        // the VU faceplate owns the full zone visually — the
        // glass rail would leak the blurred backdrop beside a
        // cream plate; queue rides the backdrop like np does
        opaque-below: root.vu-open;
        toggle-play => {
            root.toggle-play();
        }
        next-track => {
            root.next-track();
        }
        prev-track => {
            root.prev-track();
        }
        // same semantics as the top-bar back: on the library it
        // walks the browse levels (exits at the root level), on
        // the other pages it pops the page stack
        back => {
            if (root.page == Page.library) {
                root.lib-back();
            } else {
                root.nav-back();
            }
        }
        home => {
            root.nav-home();
        }
    }

    // standby covers the app content while the player is powered
    // off — the banner, OSD, hotspot and update overlays mount
    // later and paint above it (slint paints in document order)
    if !root.powered && root.provider-status == "": StandbyView {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        clock-label: root.clock-label;
        clock-valid: root.clock-valid;
        clock-date: root.clock-date;
        clock-minute: root.clock-minute;
        clock-hour: root.clock-hour;
        analog: root.clock-analog;
        skin-factory: root.standby-skin-factory;
        skin-active: root.standby-skin-active;
        bg-a: root.standby-bg-a;
        bg-b: root.standby-bg-b;
        bg-front-b: root.standby-bg-front-b;
        bg-shown: root.standby-bg-shown;
        bg-dim: root.standby-bg-dim;
        power-on => {
            root.standby-power-on();
        }
    }

    // A failed connection must not hide the settings required to
    // repair it. The banner stays above standby and content, but
    // only its own row captures input. The Connection page already
    // shows the full status, so no banner is needed there.
    if root.provider-status != "" && !(root.page == Page.settings && root.subview == 7): ConnectionBanner {
        x: 12px;
        y: root.capsule-page ? 60px : 12px;
        width: root.width - root.rail-width - 24px;
        status-text: root.provider-status;
        open-settings => {
            if root.page != Page.settings {
                root.nav-go(Page.settings);
            }
            root.push-subview(7);
        }
    }

    // transient notifications above everything — volume OSD and
    // queue-add toasts read over any layer, standby included
    OsdLayer {
        width: 100%;
        height: 100%;
        toast-visible: root.toast-visible;
        toast-text: root.toast-text;
        osd-visible: root.osd-visible;
        osd-level: root.osd-level;
        toast-anchor: root.toast-anchor;
        osd-anchor: root.osd-anchor;
        solid: root.osd-solid;
    }

    // first-run: no connection configured — the wizard QR owns
    // the screen until url + token land and the session rewires
    property <bool> first-run-dismissed: false;
    // an empty connection caused by config errors is not a first
    // run: say what broke instead of silently starting over
    property <bool> config-broken: root.first-run && root.config-problems.length > 0 && !root.setup-anyway;
    if root.config-broken && !root.first-run-dismissed: ConfigErrorView {
        width: 100%;
        height: 100%;
        problems: root.config-problems;
        start-setup => {
            root.setup-anyway = true;
        }
        restart-app => {
            root.restart-app();
        }
    }
    if root.first-run && !root.config-broken && !root.first-run-dismissed: FirstRunView {
        width: 100%;
        height: 100%;
        remote-url: root.settings-remote-url;
        qr: root.first-run-qr;
        detected: root.first-run-detected;
        connected: root.provider-connected;
        restart-app => {
            root.restart-app();
        }
        dismissed => {
            root.first-run-dismissed = true;
        }
    }

    // the boot screen covers the app until the first connection;
    // first-run and config errors take over instead
    if root.startup-phase != 0 && !root.first-run: BootView {
        width: 100%;
        height: 100%;
        phase: root.startup-phase;
        server: root.startup-server;
    }

    // the wifi setup hotspot covers everything but the update —
    // standby included (it mounts later): first run and the
    // lost-network fallback alike — it hides by itself when AP mode
    // ends (the wifi manager owns the props)
    if root.hotspot-active: HotspotOverlay {
        width: 100%;
        height: 100%;
        reason: root.hotspot-reason;
        ssid: root.hotspot-ssid;
        portal: root.hotspot-portal;
        qr: root.hotspot-qr;
        saved-ssid: root.hotspot-saved-ssid;
    }

    // the system update covers everything, first-run and config
    // errors included — the screen is not usable meanwhile
    update-overlay := UpdateOverlay {
        width: 100%;
        height: 100%;
        status: root.update-status;
    }

    // the keyboard front door: one FocusScope for the whole
    // window forwarding RAW keys — Rust owns the configurable
    // key map ([keyboard] in the config) and the routing
    forward-focus: key-scope;

    key-scope := FocusScope {
        // never grab focus from a click (slint#12044: an
        // unfocused scope CONSUMES the first press — the double-
        // click hunt): this scope only ever receives focus via
        // the window forward-focus
        focus-on-click: false;
        key-pressed(ev) => {
            root.key-event(ev.text);
            accept
        }
    }
}
