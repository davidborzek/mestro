import { Theme, Icon, Icons } from "../common.slint";
import { LibEntry } from "entry.slint";

// one list row: tap opens/plays, long-press (600ms) reports to the
// page (which composes the context menu). Detail levels number
// their track rows; plain levels show the kind glyph.
export component LibRow inherits Rectangle {
    in property <LibEntry> entry;
    // 1-based row number; 0 = no numbering (kind glyph instead)
    in property <int> number: 0;
    // render a muted second line (artist · album for tracks,
    // artist for albums) — search results use it, the library
    // stays single-line
    in property <bool> two-line: false;
    callback open(LibEntry);
    callback hold(LibEntry);

    // the second-line text; empty = no second line
    property <string> sub: root.entry.kind == "track" ? (root.entry.artist != "" ? (root.entry.album-name != "" ? root.entry.artist + " · " + root.entry.album-name : root.entry.artist) : root.entry.album-name) : (root.entry.kind == "album" ? root.entry.artist : "");

    height: root.two-line ? 58px : 46px;
    background: (rta.pressed || rta.has-hover) ? #2b262180 : transparent;

    rta := TouchArea {
        // long-press (600ms) opens the context menu; the timer runs
        // while the finger is down, so a drag stops it
        property <bool> hold-fired: false;

        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                self.hold-fired = false;
            }
        }

        clicked => {
            if (!self.hold-fired) {
                root.open(root.entry);
            }
        }
    }

    hold-timer := Timer {
        interval: 600ms;
        running: rta.pressed && !rta.hold-fired;
        triggered => {
            rta.hold-fired = true;
            root.hold(root.entry);
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;

        // numbered track rows in detail levels
        if root.number > 0: Text {
            text: root.number;
            width: 20px;
            font-size: 14px;
            color: Theme.text-mute;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        if root.number == 0: Text {
            text: Icons.glyph(root.entry.icon != Icon.none ? root.entry.icon : (root.entry.kind == "folder" ? Icon.chevron-right : root.entry.kind == "artist" ? Icon.artist : root.entry.kind == "album" ? Icon.album : root.entry.kind == "playlist" ? Icon.queue-music : Icon.music-note));
            font-family: Theme.icon-font;
            font-size: 19px;
            color: rta.pressed || rta.has-hover ? Theme.text : Theme.text-mute;
            vertical-alignment: center;
        }

        if !root.two-line: Text {
            text: root.entry.name;
            font-size: 16px;
            color: Theme.text;
            vertical-alignment: center;
            overflow: TextOverflow.elide;
            horizontal-stretch: 1;
        }

        if root.two-line: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.entry.name;
                font-size: 15px;
                color: Theme.text;
                overflow: TextOverflow.elide;
            }

            if root.sub != "": Text {
                text: root.sub;
                font-size: 12px;
                color: Theme.text-mute;
                overflow: TextOverflow.elide;
            }
        }

        // duration for tracks
        if root.entry.kind == "track" && root.entry.duration != "": Text {
            text: root.entry.duration;
            font-size: 13px;
            color: Theme.text-mute;
            vertical-alignment: center;
        }
    }
}
