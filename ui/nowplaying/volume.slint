import { Theme, Icon, Icons } from "../common.slint";

// Volume HUD: a slim glass pill at the TOP CENTER — icon ·
// slider · value in one line, clear of the rail and the cover.
// Glass = Theme.glass over the already-blurred cover backdrop;
// the side slots are equal width so the slider sits geometrically
// centered in the pill. The slider strip is the drag area so the
// pointer can't outrun the knob; the live value tracks the root
// two-way, the volume-set callback fires on release only.
export component VolumePopup inherits PopupWindow {
    in-out property <int> volume;
    callback volume-set(int);

    // the open animation replays per show: the host resets this,
    // shows the popup and flips it one tick later (Timer) — a
    // PopupWindow has no "shown" hook to animate against
    in-out property <bool> anim-in: false;

    // the glyph follows the level — silence and quiet read
    // differently at a glance
    property <Icon> vol-icon: Icons.volume-icon(root.volume);

    width: 356px;
    height: 56px;

    Rectangle {
        // opaque panel: Slint has no backdrop blur, and
        // translucent glass over the sharp fullbleed art reads
        // dirty — the pill is a solid material
        background: Theme.panel;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: Theme.hairline;

        // drop-in: fade + a short slide from above
        opacity: root.anim-in ? 1 : 0;
        y: root.anim-in ? 0px : -10px;
        animate opacity, y {
            duration: 160ms;
            easing: ease-out;
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 10px;

            // equal side slots: the slider's midpoint lands on
            // the pill's midpoint no matter the slot content
            Rectangle {
                width: 42px;
                Text {
                    text: Icons.glyph(root.vol-icon);
                    font-family: Theme.icon-font;
                    font-size: 21px;
                    font-weight: 200;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                // full row height: a fixed height would pin the
                // strip to the top of the row (the layout centers
                // only what it stretches); the track centers
                // itself inside
                vertical-stretch: 1;

                ta := TouchArea {
                    mouse-cursor: ew-resize;
                    changed mouse-x => {
                        if (ta.pressed) {
                            root.volume = Math.round(Math.clamp(
                                (ta.mouse-x - 8px) / (self.width - 16px) * 100,
                                0, 100));
                        }
                    }
                    changed pressed => {
                        if (!ta.pressed) {
                            root.volume-set(Math.round(root.volume));
                        }
                    }
                }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 3px;
                    border-radius: 2px;
                    background: Theme.bar;

                    Rectangle {
                        x: 0;
                        height: parent.height;
                        width: parent.width * root.volume / 100;
                        background: Theme.accent;
                        border-radius: 2px;
                    }
                }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 12px;
                    width: 12px;
                    border-radius: self.width / 2;
                    background: Theme.text;
                    x: (parent.width - self.width) * root.volume / 100;
                }
            }

            Rectangle {
                width: 42px;
                Text {
                    text: "\{Math.floor(root.volume)}%";
                    font-size: 14px;
                    font-weight: 300;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }
}
