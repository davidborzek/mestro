import { Theme } from "../common.slint";
import { SectionLabel, SliderRow } from "widgets.slint";

// [display]: backlight settings. Rendered only when the
// runtime found a backlight device (display-supported).
export component DisplaySettings inherits VerticalLayout {
    in property <float> display-brightness: 100;
    in property <bool> display-brightness-overridden: false;
    in property <float> display-standby-brightness: 15;
    in property <bool> display-standby-brightness-overridden: false;

    callback set-num(string, float);
    callback reset-value(string);

    spacing: 8px;

    SectionLabel {
        label: @tr("BACKLIGHT");
    }

    SliderRow {
        label: @tr("Brightness");
        key: "display.brightness";
        value: root.display-brightness;
        min: 1;
        max: 100;
        overridden: root.display-brightness-overridden;
        set-num(k, v) => {
            root.set-num(k, v);
        }
        reset-key(k) => {
            root.reset-value(k);
        }
    }

    SectionLabel {
        label: @tr("STANDBY");
    }

    SliderRow {
        label: @tr("Dim to");
        key: "display.standby-brightness";
        value: root.display-standby-brightness;
        min: 0;
        max: 100;
        overridden: root.display-standby-brightness-overridden;
        set-num(k, v) => {
            root.set-num(k, v);
        }
        reset-key(k) => {
            root.reset-value(k);
        }
    }

    Text {
        text: @tr("While the standby clock shows. 0 turns the panel dark, 100 keeps it at full brightness.");
        font-size: 12px;
        color: Theme.text-mute;
        wrap: word-wrap;
    }
}
