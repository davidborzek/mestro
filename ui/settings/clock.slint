import { Theme } from "../common.slint";
import {
    SectionLabel,
    GlyphBtn,
    PickerRow,
    PickerRequest,
    ToggleRow,
    SliderRow,
    StepperRow,
} from "widgets.slint";

// one tile in the clock gallery: the style name and its
// render-once preview (src/standby.rs)
export struct ClockPreview {
    name: string,
    preview: image,
}

component ClockTile inherits Rectangle {
    in property <ClockPreview> entry;
    in property <bool> selected;
    callback picked(string);

    border-radius: 12px;
    background: ta.has-hover ? Theme.tile-hover : Theme.tile;
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.accent;

    ta := TouchArea {
        clicked => {
            root.picked(root.entry.name);
        }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        Rectangle {
            border-radius: 8px;
            clip: true;
            background: #000;
            Image {
                width: 100%;
                height: 100%;
                source: root.entry.preview;
                image-fit: contain;
            }
        }

        Text {
            text: root.entry.name;
            height: 16px;
            horizontal-alignment: center;
            font-size: 12px;
            letter-spacing: 1px;
            font-weight: root.selected ? 700 : 500;
            color: root.selected ? Theme.accent : Theme.text-dim;
        }
    }
}

// [clock]: the standby clock face. A two-column gallery of
// rendered previews instead of a text picker; a tap selects.
export component ClockSettings inherits VerticalLayout {
    in property <string> clock-style: "digital";
    in property <[ClockPreview]> clock-previews: [];
    in property <bool> clock-style-overridden: false;
    // [clock.background]
    in property <string> bg-source: "black";
    in property <bool> bg-source-overridden: false;
    in property <float> bg-dim: 60;          // percent
    in property <bool> bg-dim-overridden: false;
    in property <bool> bg-blur: false;
    in property <bool> bg-blur-overridden: false;
    in property <float> bg-interval: 10;
    in property <bool> bg-interval-overridden: false;

    callback set-text(string, string);
    callback set-num(string, float);
    callback set-bool(string, bool);
    callback reset-value(string);
    callback request-picker(PickerRequest);

    property <length> gap: 8px;

    spacing: 8px;

    HorizontalLayout {
        SectionLabel {
            label: @tr("STANDBY CLOCK");
            horizontal-stretch: 1;
        }

        if root.clock-style-overridden: GlyphBtn {
            glyph: "↺";
            clicked => {
                root.reset-value("clock.style");
            }
        }
    }

    // rows of two tiles; the model is flat, so each row picks its
    // pair by index (an odd count leaves an empty slot)
    // (an odd count leaves the second slot as an empty spacer, so
    // the last tile keeps half the width)
    for row[r] in Math.ceil(root.clock-previews.length / 2): HorizontalLayout {
        spacing: root.gap;
        height: 150px;
        for col[c] in 2: Rectangle {
            horizontal-stretch: 1;
            if r * 2 + c < root.clock-previews.length: ClockTile {
                width: parent.width;
                height: parent.height;
                entry: root.clock-previews[r * 2 + c];
                selected: root.clock-previews[r * 2 + c].name == root.clock-style;
                picked(name) => {
                    root.set-text("clock.style", name);
                }
            }
        }
    }

    SectionLabel {
        label: @tr("BACKGROUND");
    }

    PickerRow {
        label: @tr("Source");
        key: "clock.background.source";
        value: root.bg-source;
        overridden: root.bg-source-overridden;
        open => {
            root.request-picker({
                key: "clock.background.source",
                title: "Background",
                options: ["black", "cover", "folder"],
                selected: root.bg-source == "cover" ? 1 : (root.bg-source == "folder" ? 2 : 0),
                is-bool: false,
            });
        }
        reset-key(k) => {
            root.reset-value(k);
        }
    }

    if root.bg-source != "black": SliderRow {
        label: @tr("Darken");
        key: "clock.background.dim-percent";
        value: root.bg-dim;
        min: 0;
        max: 100;
        overridden: root.bg-dim-overridden;
        // the config stores 0..1; the slider speaks percent
        set-num(k, v) => {
            root.set-num("clock.background.dim", v / 100);
        }
        reset-key(k) => {
            root.reset-value("clock.background.dim");
        }
    }
    if root.bg-source != "black": ToggleRow {
        label: @tr("Blur");
        key: "clock.background.blur";
        value: root.bg-blur;
        overridden: root.bg-blur-overridden;
        set-bool(k, v) => {
            root.set-bool(k, v);
        }
        reset-key(k) => {
            root.reset-value(k);
        }
    }
    if root.bg-source == "folder": StepperRow {
        label: @tr("Minutes per image");
        key: "clock.background.interval";
        value: root.bg-interval;
        min: 0;
        max: 120;
        step: 5;
        overridden: root.bg-interval-overridden;
        set-num(k, v) => {
            root.set-num(k, v);
        }
        reset-key(k) => {
            root.reset-value(k);
        }
    }
    if root.bg-source == "folder": Text {
        text: @tr("Images: jpg/png in /data/backgrounds on the data partition.");
        font-size: 12px;
        color: Theme.text-mute;
        wrap: word-wrap;
    }
}
