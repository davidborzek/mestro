import { Theme, Icon, Icons } from "../common.slint";

// one static, render-once VU preview from Rust
export struct VuPreviewData {
    image: image,
    name: string,
    kind: string,
    active: bool,
}

// the VU picker: a full-page three-column grid of render-once
// previews in [vu] cycle order. Selection is immediate and
// returns to the faceplate. The nav rail back closes the page.
export component VuOverview inherits Rectangle {
    in property <bool> open: false;
    in property <[VuPreviewData]> items: [];
    callback select(int);
    callback back();

    visible: root.open;
    background: Theme.bg;

    VerticalLayout {
        padding: 16px;
        padding-top: 12px;
        spacing: 10px;

        HorizontalLayout {
            height: 38px;
            Text {
                text: @tr("VU STYLES");
                font-size: 12px;
                letter-spacing: 2px;
                color: Theme.text-mute;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Text {
                text: root.items.length + " " + @tr("views");
                font-size: 11px;
                color: Theme.text-mute;
                vertical-alignment: center;
            }
        }

        Flickable {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: grid.preferred-height;

            grid := GridLayout {
                spacing: 10px;

                for item[i] in root.items: Rectangle {
                    row: i / 3;
                    col: Math.mod(i, 3);
                    height: self.width * 344px / 573px;
                    border-radius: 12px;
                    border-width: item.active ? 2px : 1px;
                    border-color: item.active ? Theme.accent : Theme.hairline;
                    background: Theme.tile;
                    clip: true;

                    TouchArea {
                        clicked => {
                            root.select(i);
                        }
                    }

                    Image {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        source: item.image;
                        image-fit: fill;
                    }

                    Rectangle {
                        x: 7px;
                        y: 7px;
                        width: 38px;
                        height: 19px;
                        border-radius: 9px;
                        background: #08090db3;
                        Text {
                            x: 6px;
                            width: parent.width - 12px;
                            text: item.kind;
                            font-size: 9px;
                            letter-spacing: 1px;
                            color: Theme.text-mute;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        x: 7px;
                        y: parent.height - 29px;
                        width: name-label.width + 16px;
                        height: 22px;
                        border-radius: 7px;
                        background: #08090dc7;

                        name-label := Text {
                            x: 8px;
                            width: self.preferred-width;
                            text: item.name;
                            font-size: 11px;
                            letter-spacing: 1px;
                            color: item.active ? Theme.accent : Theme.text;
                            vertical-alignment: center;
                        }
                    }

                    if item.active: Rectangle {
                        x: parent.width - 31px;
                        y: parent.height - 31px;
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: Theme.accent;

                        Text {
                            text: Icons.glyph(Icon.recommend);
                            font-family: Theme.icon-font;
                            font-size: 14px;
                            color: Theme.bg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }
        }
    }
}
