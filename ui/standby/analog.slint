// the analog standby clock: a ring of 60 minute marks whose
// elapsed part lights up in the accent (the ring doubles as the
// hour's progress), a hollow hour hand, an accent minute hand with
// a counterweight tail. Minute resolution only, no seconds hand:
// one repaint per minute keeps standby idle. Size is fixed;
// placement and burn-in jitter live in the standby view.
//
// Everything is placed with sin/cos instead of transform-rotation:
// the software renderer behind the settings previews cannot rotate,
// so hands are chains of overlapping dots along their axis.
export component AnalogClock inherits Rectangle {
    in property <int> clock-hour;
    in property <int> clock-minute;
    // passed in (no Theme import: the settings preview
    // compiles this file standalone at runtime)
    in property <color> accent: #d8a657;

    width: 260px;
    height: 260px;

    property <length> ring-radius: 120px;
    property <length> hour-length: 64px;
    property <length> hour-tail: 10px;
    property <length> minute-length: 104px;
    property <length> minute-tail: 16px;
    property <color> lit: root.accent.darker(0.15);
    property <color> unlit: #26221e;
    property <color> unlit-hour: #4a443b;
    property <color> hand: #a59a8a;
    property <angle> minute-angle: 6deg * root.clock-minute;
    property <angle> hour-angle: 30deg * Math.mod(root.clock-hour, 12) + 0.5deg * root.clock-minute;

    // 60 marks: larger dots at the hours, small ones between
    for m[index] in 60: Rectangle {
        property <bool> hour-mark: Math.mod(index, 5) == 0;
        property <bool> elapsed: index <= root.clock-minute;
        property <angle> a: 6deg * index;
        width: self.hour-mark ? 7px : 3px;
        height: self.width;
        border-radius: self.width / 2;
        x: root.width / 2 + root.ring-radius * Math.sin(self.a) - self.width / 2;
        y: root.height / 2 - root.ring-radius * Math.cos(self.a) - self.height / 2;
        background: self.elapsed ? root.lit : (self.hour-mark ? root.unlit-hour : root.unlit);
    }

    // hour hand outline: 7px dots from the tail to the tip, ~1px
    // apart so they merge into one stroke
    for d[i] in 75: Rectangle {
        property <length> r: -root.hour-tail + (root.hour-length + root.hour-tail) * i / 74;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        x: root.width / 2 + self.r * Math.sin(root.hour-angle) - self.width / 2;
        y: root.height / 2 - self.r * Math.cos(root.hour-angle) - self.height / 2;
        background: root.hand;
    }
    // ...hollowed by a black core (ends stay solid)
    for d[i] in 63: Rectangle {
        property <length> r: -root.hour-tail + 6px + (root.hour-length + root.hour-tail - 12px) * i / 62;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        x: root.width / 2 + self.r * Math.sin(root.hour-angle) - self.width / 2;
        y: root.height / 2 - self.r * Math.cos(root.hour-angle) - self.height / 2;
        background: #000;
    }

    // minute hand: thin accent chain with a counterweight tail
    for d[i] in 121: Rectangle {
        property <length> r: -root.minute-tail + (root.minute-length + root.minute-tail) * i / 120;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        x: root.width / 2 + self.r * Math.sin(root.minute-angle) - self.width / 2;
        y: root.height / 2 - self.r * Math.cos(root.minute-angle) - self.height / 2;
        background: root.lit;
    }

    // center cap: accent ring over both hands, a light pin inside
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        border-width: 2px;
        border-color: root.lit;
        background: #000;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: root.hand;
    }
}
