+static int edt_i2c_read_byte(struct i2c_client *client, u8 reg, u8 *val)
+{
+	struct i2c_msg msg[2];
+	int ret;
+
+	msg[0].addr = client->addr;
+	msg[0].flags = 0;
+	msg[0].len = 1;
+	msg[0].buf = &reg;
+
+	msg[1].addr = client->addr;
+	msg[1].flags = I2C_M_RD;
+	msg[1].len = 1;
+	msg[1].buf = val;
+
+	ret = i2c_transfer(client->adapter, msg, 2);
+	if (ret == 2)
+		return 0;
+
+	return ret < 0 ? ret : -EIO;
+}
