config BR2_PACKAGE_MESTRO
	bool "mestro"
	depends on BR2_aarch64
	depends on BR2_PACKAGE_HAS_UDEV
	depends on BR2_PACKAGE_HAS_LIBGBM
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_HOST_RUSTC
	select BR2_PACKAGE_SEATD
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_LIBINPUT
	select BR2_PACKAGE_FONTCONFIG
	select BR2_PACKAGE_FONT_INTER
	select BR2_PACKAGE_FONT_MATERIAL_SYMBOLS
	help
	  mestro — the Music Assistant player. Built from this
	  repository with Buildroot's Rust toolchain, with the kiosk
	  features (linuxkms, ota, wifi-setup, audio-output, timezone);
	  see image/README.md. The dependencies are the binary's
	  runtime libs (libseat, libxkbcommon, libudev, libinput,
	  libgbm, libfontconfig); the GL stack providing libgbm is
	  selected by the board config.
