#!/bin/sh
# mestro-upgrade — thin wrapper: the A/B upgrade lives in
# /usr/sbin/mestro-update (Rust, mestro-update); these flags keep
# their old names (SSH habits, the README). The
# status output is unchanged, line for line.
case "$1" in
--commit)
	exec /usr/sbin/mestro-update commit
	;;
--status)
	exec /usr/sbin/mestro-update status
	;;
--abandon)
	exec /usr/sbin/mestro-update abandon
	;;
--reboot)
	shift
	exec /usr/sbin/mestro-update install --reboot "$@"
	;;
esac
[ -n "$1" ] || {
	echo "usage: mestro-upgrade [--reboot] <new-Image | -> [sha256] | --commit | --abandon | --status" >&2
	exit 2
}
exec /usr/sbin/mestro-update install "$@"
