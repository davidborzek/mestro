#!/bin/sh
# mestro-reboot — thin wrapper: the clean reboot lives in
# /usr/sbin/mestro-update reboot (Rust); busybox reboot would ask
# PID 1 to restart userspace, and the whole system lives in an
# initramfs — nothing would come back up.
if [ "$1" = "--tryboot" ]; then
	exec /usr/sbin/mestro-update reboot --tryboot
fi
exec /usr/sbin/mestro-update reboot
