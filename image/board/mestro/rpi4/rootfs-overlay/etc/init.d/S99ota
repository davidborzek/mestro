#!/bin/sh
# S99ota — decide a trial boot (mestro-upgrade): commit the new slot
# once it has proven itself, otherwise reboot normally, which lands
# on the previous slot again (the firmware's tryboot flag is gone).
#
# Healthy means: mestro runs stably, the device is on a network, and
# mestro's web endpoint answers. The network counts when wlan0 or
# eth0 has an IPv4 address — with a default route (joined a
# network), or on wlan0 without one (the setup hotspot: a device
# that has no wifi configured yet must still be able to commit).
# Everything is retried until HEALTH_DEADLINE seconds after boot:
# wifi and DHCP take their time.
#
# The watchdog and the log snapshots belong to S04trial, which arms
# both at the start of the boot; this script only decides and tells
# it through DECISION.

# mestro has to stay up this long before the other checks count
SETTLE=20
# give up and roll back this long after the kernel started (seconds
# since boot, not since this script: the boot itself takes a while);
# S04trial's GUARD_MAX is the hard limit behind it
HEALTH_DEADLINE=120
STEP=5
WEB_URL=http://127.0.0.1/pair/status
DECISION=/run/trial-decision
TRIAL_LOG_DIR=/data/state/mestro/trial-boot

uptime_s() {
	cut -d. -f1 /proc/uptime
}

# an IPv4 address on wlan0/eth0 plus a default route, or an address
# on wlan0 alone (the setup hotspot hands out its own subnet)
network_up() {
	for dev in wlan0 eth0; do
		ip -4 addr show dev "$dev" 2>/dev/null | grep -q "inet " || continue
		ip -4 route show default dev "$dev" 2>/dev/null | grep -q . && return 0
		[ "$dev" = wlan0 ] && return 0
	done
	return 1
}

web_up() {
	wget -q -T 3 -O /dev/null "$WEB_URL"
}

summary() {
	mkdir -p "$TRIAL_LOG_DIR" || return
	{
		date
		mestro-upgrade --status
		echo "result: $1"
		ip -4 addr
		ip -4 route
	} >"$TRIAL_LOG_DIR/summary.txt" 2>&1
	sync
}

check() {
	sleep 5
	PID=$(pidof mestro)
	sleep "$SETTLE"
	while :; do
		up=$(uptime_s)
		if [ -z "$PID" ] || [ "$(pidof mestro)" != "$PID" ]; then
			reason="mestro not running stably"
			break
		fi
		net=no
		web=no
		network_up && net=yes
		web_up && web=yes
		echo "trial check at ${up}s: mestro=yes network=$net web=$web"
		if [ "$net" = yes ] && [ "$web" = yes ]; then
			echo "trial boot healthy at ${up}s"
			summary healthy
			mestro-upgrade --commit && echo commit >"$DECISION"
			return
		fi
		if [ "$up" -ge "$HEALTH_DEADLINE" ]; then
			if [ "$net" = no ]; then
				reason="no network"
			else
				reason="web endpoint not answering"
			fi
			break
		fi
		sleep "$STEP"
	done
	echo "trial boot unhealthy ($reason) at $(uptime_s)s, rolling back"
	summary "unhealthy: $reason"
	echo reboot >"$DECISION"
	# the guard's last snapshot needs the line above in ota.log
	sleep 6
	mestro-reboot
}

case "$1" in
start)
	if [ "$(hexdump -v -e '4/1 "%02x"' /proc/device-tree/chosen/bootloader/tryboot 2>/dev/null)" != "00000001" ]; then
		# a normal boot with a trial still pending: that trial never
		# committed (crash, hang, rollback) — drop it
		mestro-upgrade --abandon >>/tmp/ota.log 2>&1
		exit 0
	fi
	echo "trial boot: checking health until ${HEALTH_DEADLINE}s after boot (now $(uptime_s)s)" >>/tmp/ota.log
	check >>/tmp/ota.log 2>&1 </dev/null &
	;;
esac
