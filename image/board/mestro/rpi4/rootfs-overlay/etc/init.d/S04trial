#!/bin/sh
# S04trial — the trial boot's guard and decision
# (mestro-update trial, in the background: the process itself knows
# whether this is a trial boot — on a normal boot it only drops a
# trial that never committed).

case "$1" in
start)
	# the trial logs go to the state dir on the data partition (the
	# same XDG_STATE_HOME S50mestro gives the player); without it
	# they would land in RAM and be gone after a rollback
	XDG_STATE_HOME=/data/state mestro-update trial >>/tmp/ota.log 2>&1 </dev/null &
	;;
esac
