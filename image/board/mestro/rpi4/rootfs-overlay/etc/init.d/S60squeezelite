#!/bin/sh
# S60squeezelite — the audio player, config via /data/squeezelite.env
# (option 2: env file + service restart, no in-process control).
#
#	OUTPUT=hw:CARD=DAC	# bit-perfect ALSA device
#	SERVER=			# Music Assistant host; empty = discovery
#	NAME=mestro
#	EXTRA="-r -Z 100"

case "$1" in
start)
	[ -d /data ] || exit 0
	. /data/squeezelite.env
	# the VU shm ring is named after the interface MAC — wait for the
	# network so it isn't written with 00:00:00:00:00:00 (mestro
	# matches it by its own MAC)
	n=0
	while [ $n -lt 30 ]; do
		ip -4 addr show dev eth0 2>/dev/null | grep -q "inet " && break
		ip -4 addr show dev wlan0 2>/dev/null | grep -q "inet " && break
		n=$((n + 1))
		sleep 1
	done
	rm -f /dev/shm/squeezelite-00:00:00:00:00:00
	start-stop-daemon -S -b -x /usr/bin/squeezelite -- \
		-v -o "$OUTPUT" ${SERVER:+-s "$SERVER"} -n "$NAME" $EXTRA
	;;
stop)
	start-stop-daemon -K -x /usr/bin/squeezelite
	;;
restart)
	"$0" stop
	sleep 1
	"$0" start
	;;
esac
