#!/bin/sh
# S60squeezelite — the audio player. mestro owns its config: it writes
# /data/state/mestro/squeezelite.env (clean LF) from the audio
# settings (Settings → Audio, [audio] in config.toml) and restarts
# this script when the content changes. Nothing else is read; without
# the file squeezelite runs on its own defaults.
#
#	OUTPUT=hw:CARD=DAC	# ALSA device (empty = squeezelite's default)
#	SERVER=192.168.1.5	# Music Assistant host (empty = discovery)
#	NAME=HiFi		# the player's name
#	EXTRA='-r -Z 100'	# further flags, split on whitespace

case "$1" in
start)
	[ -d /data ] || exit 0
	# env-source:begin
	unset OUTPUT NAME SERVER EXTRA
	[ -f /data/state/mestro/squeezelite.env ] && . /data/state/mestro/squeezelite.env
	# env-source:end
	# the VU shm ring is named after the interface MAC — wait for the
	# network so it isn't written with 00:00:00:00:00:00 (mestro
	# matches it by its own MAC)
	n=0
	while [ $n -lt 30 ]; do
		ip -4 addr show dev eth0 2>/dev/null | grep -q "inet " && break
		ip -4 addr show dev wlan0 2>/dev/null | grep -q "inet " && break
		n=$((n + 1))
		sleep 1
	done
	rm -f /dev/shm/squeezelite-00:00:00:00:00:00
	start-stop-daemon -S -b -x /usr/bin/squeezelite -- \
		-v ${OUTPUT:+-o "$OUTPUT"} ${SERVER:+-s "$SERVER"} ${NAME:+-n "$NAME"} $EXTRA
	;;
stop)
	start-stop-daemon -K -x /usr/bin/squeezelite
	;;
restart)
	"$0" stop
	sleep 1
	"$0" start
	;;
esac
