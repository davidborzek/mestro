# squeezelite env — sourced by /etc/init.d/S60squeezelite.
# Editable on any OS (FAT) or over SSH; a restart applies it:
#   /etc/init.d/S60squeezelite restart

OUTPUT=hw:CARD=DAC
# Music Assistant host (its slimproto server) — empty finds it by
# broadcast; set it only when MA sits in another subnet
SERVER=
NAME=mestro
EXTRA=""
