{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "dependencyDashboard": true,
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Berlin",
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "CI pins the dev-shell tool versions as env vars in ci.yml; keep flake.nix in sync and update the matching SHA256 pin in the same PR",
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/ci\\.yml$"],
      "matchStrings": [
        "TREEFMT_VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "numtide/treefmt"
    },
    {
      "description": "slint-lsp in CI formats the .slint tree; grouped with the slint crates so the formatter moves with the compiler",
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/ci\\.yml$"],
      "matchStrings": [
        "SLINT_LSP_VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "slint-ui/slint"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/ci\\.yml$"],
      "matchStrings": [
        "SHFMT_VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "mvdan/sh"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/ci\\.yml$"],
      "matchStrings": [
        "NIXFMT_VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "NixOS/nixfmt"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/ci\\.yml$"],
      "matchStrings": [
        "CARGO_DENY_VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "EmbarkStudios/cargo-deny"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/ci\\.yml$"],
      "matchStrings": [
        "CARGO_MACHETE_VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "bnjbvr/cargo-machete"
    }
  ],
  "packageRules": [
    {
      "description": "one PR for all Cargo minor/patch updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "cargo minor/patch"
    },
    {
      "description": "one PR for all web app minor/patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm minor/patch"
    },
    {
      "description": "minor/patch automerge once CI passes",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "major updates land as their own PRs, never automerged",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "keep GitHub Actions pinned to commit digests, one grouped PR",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "groupName": "github actions"
    },
    {
      "description": "CI tool version bumps need their SHA256 pin updated — never automerge",
      "matchManagers": ["regex"],
      "automerge": false
    },
    {
      "description": "all slint crates are pinned to the same exact version and move as one PR with the matching slint-lsp — rendering risk, never automerge; re-run the snapshot tests on bump",
      "matchPackageNames": [
        "slint",
        "slint-interpreter",
        "slint-build",
        "i-slint-core",
        "i-slint-compiler",
        "slint-ui/slint"
      ],
      "groupName": "slint",
      "automerge": false
    }
  ]
}
